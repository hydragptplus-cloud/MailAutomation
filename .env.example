DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ENV=development
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DATABASE_URL=postgresql://mailuser:mailpass@db:5432/mailautomation
REDIS_URL=redis://redis:6379/0
CACHE_REDIS_URL=redis://redis:6379/1
CACHE_KEY_PREFIX=mailflow
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
CHECKOUT_SESSION_COOKIE_NAME=mailflow_checkout
PRECHECKOUT_SESSION_COOKIE_NAME=mailflow_precheckout
CHECKOUT_SESSION_COOKIE_SECURE=0
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=
TURNSTILE_CHECKOUT_ACTION=checkout
CONTENT_SECURITY_POLICY=default-src 'self'; script-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; connect-src 'self' https://challenges.cloudflare.com; base-uri 'self'; frame-ancestors 'none'; form-action 'self'
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mailhog
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=0
EMAIL_USE_SSL=0
MAIL_FLOW_SENDER_NAME=Mail Flow Billing
MAIL_FLOW_SENDER_EMAIL=billing@example.com
MAIL_FLOW_REPLY_TO=support@example.com
FRONTEND_URL=http://localhost:5173
FIELD_ENCRYPTION_KEY=replace-with-fernet-key

# File/media storage
# filesystem is the current supported local mode.
# Use vercel_blob in production after creating a Vercel Blob store.
MEDIA_STORAGE_BACKEND=filesystem
MEDIA_STORAGE_ACCESS=public
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=
BLOB_PUBLIC_BASE_URL=

EMAIL_BATCH_SIZE=200
EMAIL_SEND_DELAY_SECONDS=0.2
MAX_UPLOAD_SIZE_BYTES=26214400
SECURE_HSTS_SECONDS=31536000

# Direct USDT subscriptions (public addresses; never add wallet private keys)
USDT_BDT_RATE=122.0000
PAYMENT_QUOTE_MINUTES=30
PAYMENT_TON_WALLET=UQCc1yYCN1q8Js-WPqA2k8kCBFr9nDbOo18j0vsH2dhxTR9s
PAYMENT_EVM_WALLET=0xd34D15736148C0e9DC185CCf2D94B648c48e1CdB
PAYMENT_TRON_WALLET=TWYfWJ3o3Bj2RdT5EHogghm3KbWzoWqx4u
USDT_ETH_CONTRACT=0xdAC17F958D2ee523a2206206994597C13D831ec7
USDT_BSC_CONTRACT=0x55d398326f99059fF775485246999027B3197955
USDT_TRON_CONTRACT=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
USDT_TON_MASTER=EQCxE6mUtQJKFnGfaROTKOt1lZbDiiX1kCixRv7Nw2Id_sDs

# Blockchain verification providers
# Keep each network disabled until its single public provider has been tested.
PAYMENT_REQUIRE_DUAL_PROVIDER=0
PAYMENT_NETWORK_BSC_ENABLED=0
BSC_RPC_URL=https://bsc-dataseed-public.bnbchain.org
PAYMENT_CONFIRMATIONS_BSC=12

PAYMENT_NETWORK_ETHEREUM_ENABLED=0
ETH_RPC_URL=https://ethereum-rpc.publicnode.com
PAYMENT_CONFIRMATIONS_ETHEREUM=12

PAYMENT_NETWORK_TRON_ENABLED=0
TRON_API_URL=https://api.trongrid.io
TRON_API_KEY=
PAYMENT_CONFIRMATIONS_TRON=20

PAYMENT_NETWORK_TON_ENABLED=0
TONCENTER_API_URL=https://toncenter.com/api/v3
TONCENTER_API_KEY=
PAYMENT_CONFIRMATIONS_TON=20
TRUST_X_FORWARDED_FOR=0

# Explicit one-time owner bootstrap:
# DJANGO_SUPERUSER_PASSWORD=... python manage.py bootstrap_owner --username admin --email admin@example.com
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=
