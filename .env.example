# Mail Flow production environment (Railway)
# Replace every CHANGE_ME value. Never commit the populated production file.

# Core Django security
DJANGO_ENV=production
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=CHANGE_ME_GENERATE_A_64_BYTE_RANDOM_SECRET
FIELD_ENCRYPTION_KEY=CHANGE_ME_GENERATE_A_FERNET_KEY
DJANGO_ALLOWED_HOSTS=mailflow.annmous.com,127.0.0.1

# Railway managed services. Use Railway reference variables.
DATABASE_URL=${{Postgres.DATABASE_URL}}
REDIS_URL=${{Redis.REDIS_URL}}
CACHE_REDIS_URL=${{Redis.REDIS_URL}}
CACHE_KEY_PREFIX=mailflow-production

# Frontend/backend origins
FRONTEND_URL=https://mail-flow.annmous.com
TRACKING_BASE_URL=https://mailflow.annmous.com
CORS_ALLOWED_ORIGINS=https://mail-flow.annmous.com
CSRF_TRUSTED_ORIGINS=https://mail-flow.annmous.com
TRUST_X_FORWARDED_FOR=1
NUM_PROXIES=1

# Secure cross-subdomain authentication
CSRF_COOKIE_SAMESITE=Lax
AUTH_COOKIE_SAMESITE=Lax
AUTH_ACCESS_COOKIE_NAME=mailflow_access
AUTH_REFRESH_COOKIE_NAME=mailflow_refresh
CHECKOUT_SESSION_COOKIE_NAME=mailflow_checkout
PRECHECKOUT_SESSION_COOKIE_NAME=mailflow_precheckout
CHECKOUT_SESSION_COOKIE_SECURE=1
CHECKOUT_SESSION_COOKIE_SAMESITE=Lax

# Browser security
SECURE_HSTS_SECONDS=31536000
CONTENT_SECURITY_POLICY=default-src 'self'; script-src 'self' https://challenges.cloudflare.com https://*.challenges.cloudflare.com; frame-src https://challenges.cloudflare.com https://*.challenges.cloudflare.com; connect-src 'self' https://mail-flow.annmous.com https://challenges.cloudflare.com https://*.challenges.cloudflare.com; base-uri 'self'; frame-ancestors 'none'; form-action 'self'

# Cloudflare Turnstile
TURNSTILE_SECRET_KEY=CHANGE_ME
TURNSTILE_EXPECTED_HOSTNAME=mail-flow.annmous.com
TURNSTILE_CHECKOUT_ACTION=checkout
VITE_TURNSTILE_SITE_KEY=CHANGE_ME_PUBLIC_SITE_KEY

# Set this build-time variable on the Railway frontend service.
VITE_API_URL=https://mailflow.annmous.com/api

# Application email provider
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=CHANGE_ME_SMTP_HOST
EMAIL_PORT=587
EMAIL_HOST_USER=CHANGE_ME
EMAIL_HOST_PASSWORD=CHANGE_ME
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
MAIL_FLOW_SENDER_NAME=Mail Flow Billing
MAIL_FLOW_SENDER_EMAIL=billing@annmous.com
MAIL_FLOW_GENERAL_SENDER_NAME=Mail Flow
MAIL_FLOW_GENERAL_SENDER_EMAIL=mailflow@annmous.com
MAIL_FLOW_REPLY_TO=support@annmous.com

# Optional external mail relays; leave URL and secret empty when unused.
MAIL_FLOW_OTP_RELAY_URL=
MAIL_FLOW_OTP_RELAY_SECRET=
MAIL_FLOW_OTP_RELAY_TIMEOUT=10
MAIL_FLOW_SMTP_TEST_RELAY_URL=
MAIL_FLOW_SMTP_TEST_RELAY_SECRET=
MAIL_FLOW_SMTP_TEST_RELAY_TIMEOUT=25
MAIL_FLOW_CAMPAIGN_RELAY_URL=
MAIL_FLOW_CAMPAIGN_RELAY_SECRET=
MAIL_FLOW_CAMPAIGN_RELAY_TIMEOUT=30

# Media storage. Attach a Railway volume at /app/media for filesystem mode.
MEDIA_STORAGE_BACKEND=filesystem
MEDIA_STORAGE_ACCESS=private
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=
BLOB_PUBLIC_BASE_URL=

# Worker and upload limits
EMAIL_BATCH_SIZE=200
EMAIL_SEND_DELAY_SECONDS=0.2
MAX_UPLOAD_SIZE_BYTES=26214400

# Direct USDT subscriptions
USDT_BDT_RATE=122.0000
PAYMENT_QUOTE_MINUTES=30
PAYMENT_TON_WALLET=CHANGE_ME_PUBLIC_TON_WALLET
PAYMENT_EVM_WALLET=CHANGE_ME_PUBLIC_EVM_WALLET
PAYMENT_TRON_WALLET=CHANGE_ME_PUBLIC_TRON_WALLET
USDT_ETH_CONTRACT=0xdAC17F958D2ee523a2206206994597C13D831ec7
USDT_BSC_CONTRACT=0x55d398326f99059fF775485246999027B3197955
USDT_TRON_CONTRACT=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
USDT_TON_MASTER=CHANGE_ME_VERIFIED_TON_USDT_MASTER

# Keep payment networks disabled until their providers and wallets are verified.
PAYMENT_REQUIRE_DUAL_PROVIDER=0
PAYMENT_NETWORK_BSC_ENABLED=0
BSC_RPC_URL=https://bsc-dataseed-public.bnbchain.org
PAYMENT_CONFIRMATIONS_BSC=12
PAYMENT_NETWORK_ETHEREUM_ENABLED=0
ETH_RPC_URL=https://ethereum-rpc.publicnode.com
PAYMENT_CONFIRMATIONS_ETHEREUM=12
PAYMENT_NETWORK_TRON_ENABLED=0
TRON_API_URL=https://api.trongrid.io
TRON_API_KEY=
PAYMENT_CONFIRMATIONS_TRON=20
PAYMENT_NETWORK_TON_ENABLED=0
TONCENTER_API_URL=https://toncenter.com/api/v3
TONCENTER_API_KEY=
PAYMENT_CONFIRMATIONS_TON=20

# One-time owner bootstrap; remove the password after successful bootstrap.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@annmous.com
DJANGO_SUPERUSER_PASSWORD=CHANGE_ME_STRONG_ONE_TIME_PASSWORD

# Celery worker and beat services only:
# SKIP_MIGRATIONS=1
